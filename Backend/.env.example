# Server
PORT=8000
NODE_ENV=development

# Docker PostgreSQL (change these development credentials as appropriate)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pets_veta
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pets_veta?schema=public

# Google Gemini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_RETRY_BASE_DELAY_MS=200

# Optional shared cache. If omitted or unavailable, bounded in-memory caching is used.
# REDIS_URL=redis://localhost:6379

# Retrieval-Augmented Generation
KNOWLEDGE_BASE_PATH=./knowledge
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5
EMBEDDING_BATCH_SIZE=16
VECTOR_STORE_BATCH_SIZE=100
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=5
VECTOR_WEIGHT=0.7
TEXT_WEIGHT=0.3
SIMILARITY_THRESHOLD=0.7
EMBEDDING_CACHE_TTL_SECONDS=86400
RESPONSE_CACHE_TTL_SECONDS=300
RAG_CACHE_MAX_ENTRIES=1000
RAG_CACHE_OPERATION_TIMEOUT_MS=100

# Logging
LOG_LEVEL=info
