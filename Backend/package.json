{
    "name": "pets-veta-backend",
    "version": "1.0.0",
    "description": "",
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "app.js",
    "scripts": {
        "test": "npm run test:rag",
        "dev": "nodemon --watch app --watch src --ext js,ts --exec \"npm run build && node app/server.js\"",
        "build": "npm run build:rag",
        "prestart": "npm run build",
        "build:rag": "tsc --project tsconfig.json",
        "typecheck:rag": "tsc --project tsconfig.json --noEmit",
        "pretest:rag-loader": "tsc --project tsconfig.test.json",
        "test:rag-loader": "node --test .test-dist/tests/rag/markdown-loader.test.js",
        "pretest:rag": "tsc --project tsconfig.test.json",
        "test:rag": "node .test-dist/tests/rag/markdown-loader.test.js && node .test-dist/tests/rag/production-markdown-loader.test.js && node .test-dist/tests/rag/markdown-chunker.test.js && node .test-dist/tests/rag/production-markdown-chunker.test.js && node .test-dist/tests/rag/embedding-service.test.js && node .test-dist/tests/rag/cache-service.test.js && node .test-dist/tests/rag/vector-store.test.js && node .test-dist/tests/rag/retriever-service.test.js && node .test-dist/tests/rag/prompt-builder.test.js && node .test-dist/tests/rag/gemini-service.test.js && node .test-dist/tests/api/ai-service.test.js && node .test-dist/tests/api/chat-api.test.js",
        "rag:test": "npm run test:rag",
        "ingest": "tsx scripts/ingest.ts",
        "generate:embeddings": "tsx scripts/generate-embeddings.ts",
        "start": "node app/server.js",
        "db:start": "docker compose up -d postgres",
        "db:stop": "docker compose down",
        "db:logs": "docker compose logs -f postgres",
        "db:shell": "docker compose exec postgres psql -U postgres -d pets_veta",
        "db:migrate": "prisma migrate deploy",
        "db:studio": "prisma studio",
        "docker:dev": "npm run db:migrate && npm run dev"
    },
    "dependencies": {
        "@google/genai": "^2.12.0",
        "@huggingface/transformers": "^4.2.0",
        "@langchain/core": "^1.2.3",
        "@langchain/textsplitters": "^1.0.1",
        "@prisma/client": "^6.19.3",
        "@socket.io/redis-adapter": "^8.3.0",
        "bcrypt": "^6.0.0",
        "cloudinary": "^2.10.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.6",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "express-rate-limit": "^8.5.2",
        "fast-glob": "^3.3.3",
        "google-auth-library": "^10.6.2",
        "gray-matter": "^4.0.3",
        "jsonwebtoken": "^9.0.3",
        "langchain": "^1.5.3",
        "markdown-it": "^14.3.0",
        "mime-types": "^3.0.2",
        "multer": "^2.1.1",
        "node-cron": "^4.5.0",
        "nodemailer": "^8.0.7",
        "pdf-parse": "^2.4.5",
        "pg": "^8.22.0",
        "pgvector": "^0.3.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "rate-limit-redis": "^5.0.0",
        "redis": "^6.0.1",
        "socket.io": "^4.8.3",
        "socket.io-client": "^4.8.3",
        "streamifier": "^0.1.1",
        "stripe": "^22.2.0",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/express": "^5.0.6",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^22.20.1",
        "@types/pg": "^8.20.0",
        "nodemon": "^3.1.14",
        "prisma": "^6.19.3",
        "tsx": "^4.23.1",
        "typescript": "^7.0.2"
    }
