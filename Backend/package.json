  "scripts": {
    "test": "npm run test:rag",
    "dev": "nodemon --watch app --watch src --ext js --exec \"node app/server.js\"",
    "build": "node -e \"console.log('JavaScript source does not need a build step')\"",
    "prestart": "npm run build",
    "build:rag": "npm run build",
    "typecheck:rag": "npm run build",
    "test:rag-loader": "node --test tests/rag/markdown-loader.test.js",
    "test:rag": "node tests/rag/markdown-loader.test.js && node tests/rag/production-markdown-loader.test.js && node tests/rag/markdown-chunker.test.js && node tests/rag/production-markdown-chunker.test.js && node tests/rag/embedding-service.test.js && node tests/rag/cache-service.test.js && node tests/rag/vector-store.test.js && node tests/rag/retriever-service.test.js && node tests/rag/prompt-builder.test.js && node tests/rag/gemini-service.test.js && node tests/api/ai-service.test.js && node tests/api/chat-api.test.js",
    "rag:test": "npm run test:rag",
    "ingest": "node scripts/ingest.js",
    "generate:embeddings": "node scripts/generate-embeddings.js",
    "start": "node app/server.js",
    "db:start": "docker compose up -d postgres",
    "db:stop": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:shell": "docker compose exec postgres psql -U postgres -d pets_veta",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "docker:dev": "npm run db:migrate && npm run dev"
  },
