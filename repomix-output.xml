    };
    pet: {
      id: string;
      name: string;
      age: number;
      breed: string;
      category: string;
    };
  };
};

type ApiResponse<T> = {
  success: boolean;
  message: string;
  data: T;
};

export const getDoctorAppointments = async () => {
  try {
    const response =
      await api.get<ApiResponse<DoctorAppointment[]>>("doctor/appointments");

    return response.data?.data || [];
  } catch (error) {
    handleAxiosError(error);
    throw error;
  }
};
