const allDoctors = async (limit, page) => {

  const skip = (page - 1) * limit;
  const [doctors, totalCount] = await prisma.$transaction([
    prisma.doctor.findMany({
      skip: skip,
      take: limit,
      select: {
        id: true,
        specialization: true,
        education: true,
        experience: true,
        isVerified: true,
        user: {
          select: {
            id: true,
            fullName: true,
            email: true,
            phone: true,
            doctorCertificate: {
              select: {
                publicUrl: true,
                publicId: true
              }
            }
          }
        }

      },
      orderBy: {
        id: 'asc'
      }
    }),
    prisma.doctor.count()
  ])
  return { doctors, totalCount };
