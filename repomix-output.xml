      shippingAddress: "",
    },
  });

  const total = cart.reduce(
    (sum, item) => sum + item.price * item.quantity,
    0
  );

  const handlePlaceOrder = async (data: CheckoutFormData) => {
    setError("");

    if (cart.length === 0) {
      setError("Your cart is empty.");
