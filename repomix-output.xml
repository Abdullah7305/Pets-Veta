                    >
                        <X size={20} />
                    </button>
                </div>

                {/* Dynamic Inner Body Container */}
                <div className="p-6 max-h-[60vh] overflow-y-auto space-y-3 custom-scrollbar">

                    {/* Loading View State */}
                    {loading && (
                        <div className="flex flex-col items-center justify-center py-12 text-[#6D3DD9]">
