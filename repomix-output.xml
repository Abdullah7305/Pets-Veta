        username,
        phone,
        profileImageUrl,
        specialization,
        education,
        experience,
        fees,
        address,
        isAvailable,
    } = profileData;

    const existingUsername = await prisma.user.findFirst({
        where: {
            username,
            NOT: {
                id: userId,
