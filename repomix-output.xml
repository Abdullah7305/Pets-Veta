                    <div className="flex items-center gap-3 rounded-[22px] border border-slate-100 bg-white px-5 py-5 text-sm font-semibold text-slate-500 shadow-[0_10px_35px_rgba(15,23,42,0.06)]">
                        <FaBoxOpen className="text-[#009f9d]" />
