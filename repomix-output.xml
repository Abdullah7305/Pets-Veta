const getParentPath = () => {
  const pathParts = window.location.pathname.split("/").filter(Boolean);

  if (pathParts.length <= 1) {
    return "/";
  }

  return `/${pathParts.slice(0, -1).join("/")}`;
};

const FloatingBackButton = () => {
  const handleBack = () => {
    if (window.history.length > 1) {
      window.history.back();
      return;
    }

    window.location.href = getParentPath();
