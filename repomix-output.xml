      try {
        const data = await fetchMarketplaceProductById(id);

        if (!ignore) {
          setProduct(data);
        }
      } catch {
        if (!ignore) {
          setError("Product not found.");
        }
      } finally {
        if (!ignore) {
          setLoading(false);
