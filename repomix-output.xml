                  <ProfileMeta
                    icon={<UserRound size={18} />}
                    label="Username / Store Name"
                    value={`@${profile.username}`}
                  />

                  <ProfileMeta
                    icon={<Mail size={18} />}
                    label="Email"
                    value={profile.email}
                  />

                  <ProfileMeta
                    icon={<Phone size={18} />}
