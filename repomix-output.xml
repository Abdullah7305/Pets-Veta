                      </span>
                    ) : (
                      <span className="flex items-center justify-center gap-2">
                        <Send size={17} />
                        Submit
                      </span>
                    )}
                  </Button>
                </div>
              </div>
            </section>
          </main>
        )}
      </div>
    </div>
  );
};

