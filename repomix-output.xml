            setSearch("");
            setPage(1);
          }}
        />

        <section className="min-w-0">
          <PageHeader />

          <DoctorsList
            doctors={doctors}
            loading={isLoading}
            onBookAppointment={handleBookAppointment}
          />

          {doctors.length > 0 && (
            <Pagination
              page={page}
              totalPages={totalPages}
              onPrevious={() => setPage((prev) => prev - 1)}
              onNext={() => setPage((prev) => prev + 1)}
            />
          )}
        </section>
      </section>
    </main>
  );
};

export default FindDoctor;
</file>

